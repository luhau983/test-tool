{
  "name": "dell-inspect",
  "version": "1.2.0",
  "private": true,
  "description": "Kiểm tra cấu hình và phần cứng Windows",
  "author": "Dell Inspect",
  "main": "src/main.cjs",
  "scripts": {
    "start": "npm run build:css && electron .",
    "build:css": "tailwindcss -i styles/app.css -o src/app.css --minify",
    "test": "node --test tests/*.test.cjs",
    "dist": "npm run build:css && electron-builder --win portable --x64",
    "test:e2e": "npm run build:css && electron tests/e2e-full.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/open-sans": "^5.3.0",
    "@tailwindcss/cli": "4.3.5",
    "daisyui": "5.8.1",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "tailwindcss": "4.3.5"
  },
  "build": {
    "appId": "local.dellinspect.app",
    "productName": "Dell Inspect",
    "directories": {
      "output": "release/v1.2.0"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "src/collect.ps1",
      "src/smart.ps1",
      "src/battery-sample.ps1",
      "src/diagnostic-worker.cjs"
    ],
    "win": {
      "target": "portable",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "Dell-Inspect-${version}-portable.exe"
    }
  }
}
